{"version": 2, "width": 130, "height": 36, "timestamp": 1793239023, "idle_time_limit": 2.0, "env": {"SHELL": "/bin/bash", "TERM": "tmux-256color"}, "title": "OSAC + NICo BMaaS: tenant onboarding, BMI create and safe delete"}
[0.011418, "o", "OSAC + NICo BMaaS: fresh tenant-to-tenant CLI demonstration\r\nTwo Kind guests on zeus12: NICo + Machine-a-Tron, and OSAC dev-full + AWX.\r\nThe admin setup uses lab APIs; the BMI lifecycle uses the public OSAC CLI.\r\nCredential values are read from lab Secrets and are never printed.\r\n\r\n=== 1. NICo identity and tenant ===\r\n$ [NICo admin] bash /tmp/nico-demo-tenant.sh\r\n"]
[4.848308, "o", "Authenticating Keycloak administrator\r\n"]
[5.296334, "o", "Ensuring tenant role\r\n"]
[5.479083, "o", "Ensuring tenant user\r\n"]
[5.659886, "o", "{\r\n  \"username\": \"osac-demo\",\r\n  \"attributes\": {\r\n    \"oidc_id\": [\r\n      \"osac-demo-oidc-001\"\r\n    ]\r\n  },\r\n  \"requiredActions\": []\r\n}\r\nSetting tenant user password and role\r\n"]
[6.061436, "o", "Authenticating tenant user\r\n"]
[6.505206, "o", "Creating or retrieving NICo tenant\r\n"]
[6.684525, "o", "{\r\n  \"id\": \"62a06914-fdcf-44e0-8c56-df9d06849a14\",\r\n  \"org\": \"test-org-demo\",\r\n  \"orgDisplayName\": \"test-org-demo\"\r\n}\r\ncross_org_status=403\r\n{\"iss\": \"http://localhost:18082/realms/nico-dev\", \"realmRoles\": [\"offline_access\", \"uma_authorization\", \"default-roles-nico-dev\", \"test-org-demo:TENANT_ADMIN\"], \"emailPresent\": true, \"oidcIdPresent\": true}\r\n"]
[6.686217, "o", "\r\n=== 2. NICo account, reserved capacity, and network ===\r\n$ [NICo provider] bash /tmp/nico-demo-resources.sh\r\n"]
[12.477005, "o", "Creating tenant account\r\n"]
[12.654894, "o", "Accepting tenant account invitation\r\n"]
[12.833552, "o", "Associating the demo Ready Machine with the pilot Instance Type\r\n"]
[13.01256, "o", "Creating separate provider IPv4 block\r\n"]
[13.191421, "o", "Allocating one simulated Machine\r\n"]
[13.372367, "o", "provider_id=e2dbcbea-e0f5-4bb1-a75d-9d4674a45504\r\ntenant_id=62a06914-fdcf-44e0-8c56-df9d06849a14\r\naccount_id=a8930c15-8034-4707-bd60-455e5f0f0e2b\r\nsite_id=e49c0c9c-01a3-4b3d-9cc0-12396e88911a\r\ncompute_allocation_id=4344a086-2f5c-4c96-b391-052deeee0df0\r\nnetwork_allocation_id=2f85ef39-ee3f-46cd-aca7-6498e951311c\r\nderived_block_id=9a173b42-9741-44b0-bddc-c6fa9d3d8b48\r\nAllocating separate IPv4 block\r\n"]
[13.374673, "o", "$ [NICo tenant] DEMO_BLOCK_ID=<allocated block ID> bash /tmp/nico-demo-network.sh\r\n"]
[18.636611, "o", "Creating demo tenant Ethernet virtualizer VPC\r\n"]
[18.817671, "o", "VPC request: {\"name\":\"osac-demo-vpc\",\"siteId\":\"e49c0c9c-01a3-4b3d-9cc0-12396e88911a\",\"networkVirtualizationType\":\"ETHERNET_VIRTUALIZER\"}\r\n"]
[18.998556, "o", "Creating demo tenant /28 Subnet\r\n"]
[92.286445, "o", "vpc_id=7f8287c9-dc42-4a11-8920-1e61163f0fc1\r\nsubnet_id=28fa2c59-e2b6-4396-9397-e5865784be14\r\n"]
[92.47085, "o", "\r\n=== 3. OSAC user and tenant onboarding ===\r\n$ [OSAC admin] bash /tmp/nico-osac-demo-user.sh\r\n"]
[98.956677, "o", "OSAC Keycloak user tenant_demo_user is ready; password is in the lab Secret and a mode-600 CLI file.\r\n"]
[99.138032, "o", "$ [OSAC admin] TENANT=tenant-demo TENANT_USERS=tenant_demo_user provision-tenant.sh osac\r\n"]
[103.983925, "o", "[+] Provisioning tenant 'tenant-demo' in namespace 'osac'...\r\n"]
[109.90253, "o", "[+]   tenant 'tenant-demo' created (default network auto-provisioned)\r\n"]
[110.225609, "o", "[+]   subnet target namespace ready: subnet-4jqlc\r\n"]
[113.449372, "o", "[+]   organization 'tenant-demo' already exists\r\n"]
[113.629825, "o", "[+]     member added: tenant_demo_user\r\n[+] Tenant 'tenant-demo' ready — log in as one of: tenant_demo_user (password: keycloak default-user-password)\r\n"]
[113.632712, "o", "\r\n=== 4. OSAC tenant CLI login and matching network ===\r\n"]
[118.459326, "o", "\r\n$ osac login --flow password --user tenant_demo_user --password-file /tmp/nico-osac-demo-password --insecure fulfillment-api.osac.localhost:8443\r\n"]
[118.774345, "o", "Warning: no usable operating system keyring was found, so your access and refresh tokens were saved\r\nunencrypted in your configuration directory instead of the system keyring.\r\n\r\n"]
[118.953855, "o", "\r\n$ osac whoami\r\nLogged in as: tenant_demo_user\r\nTenant: tenant-demo\r\nRoles: offline_access, uma_authorization, default-roles-my realm\r\n\r\n$ osac get tenants tenant-demo\r\n"]
[119.12977, "o", "PROJECT  DELETING  ID           NAME\r\n-        -         tenant-demo"]
[119.161093, "o", "  tenant-demo\r\n\r\n$ osac create virtualnetwork --name nico-demo-vpc --ipv4-cidr 10.217.100.0/24\r\n"]
[119.388365, "o", "Created virtual network 'nico-demo-vpc' (ID: 01a18561-d316-7a23-916c-5fd8162f42e0).\r\n"]
[119.668774, "o", "\r\n$ osac get virtualnetworks nico-demo-vpc\r\n"]
[119.913001, "o", "TENANT       DELETING  PROJECT  ID                                    NAME           IPV4-CIDR        IPV6-CIDR  STATE\r\ntenant-demo  -         -        01a18561-d316-7a23-916c-5fd8162f42e0  nico-demo-vpc  10.217.100.0/24  -          READY\r\n"]
[120.092693, "o", "\r\n$ osac create subnet --name nico-demo-subnet --virtual-network 01a18561-d316-7a23-916c-5fd8162f42e0 --ipv4-cidr 10.217.100.0/28\r\n"]
[120.275693, "o", "Created subnet 'nico-demo-subnet' (ID: 01a18561-d62a-732f-82c2-dcf65f861d92).\r\n"]
[120.457075, "o", "\r\n$ osac get subnets nico-demo-subnet\r\n"]
[120.68899, "o", "TENANT       DELETING  PROJECT  ID                                    NAME              VIRTUAL-NETWORK  IPV4-CIDR        IPV6-CIDR  STATE\r\ntenant-demo  -         -        01a18561-d62a-732f-82c2-dcf65f861d92  nico-demo-subnet  nico-demo-vpc    10.217.100.0/28  -          READY\r\n"]
[121.067404, "o", "\r\n=== 4. Complete OSAC tenant network ===\r\n"]
[126.236301, "o", "\r\n$ osac create securitygroup --name nico-demo-sg --virtual-network 01a18561-d316-7a23-916c-5fd8162f42e0\r\n"]
[126.481101, "o", "Created security group 'nico-demo-sg' (ID: 01a18562-938c-7351-a188-e30e99b738a4).\r\n"]
[126.659567, "o", "\r\n$ osac get securitygroups nico-demo-sg\r\n"]
[126.83942, "o", "TENANT       DELETING  PROJECT  ID                                    NAME          VIRTUAL-NETWORK  INGRESS-RULES  EGRESS-RULES  STATE\r\ntenant-demo  -         -        01a18562-938c-7351-a188-e30e99b738a4  nico-demo-sg  nico-demo-vpc    0              0             READY\r\n"]
[127.018682, "o", "\r\nOSAC tenant-demo maps to Subnet 01a18561-d62a-732f-82c2-dcf65f861d92; the NICo binding will use this ID.\r\n"]
[127.020612, "o", "\r\n=== 5. Explicit tenant/Subnet -> AWX NICo credential binding ===\r\n"]
[169.217054, "o", "$ [AWX admin] python3 /tmp/nico-demo-awx.py  # secret inputs hidden\r\n"]
[174.665151, "o", "{\r\n  \"awxCredentialID\": 6,\r\n  \"osacTenant\": \"tenant-demo\",\r\n  \"osacSubnetID\": \"01a18561-d62a-732f-82c2-dcf65f861d92\",\r\n  \"nicoTenantID\": \"62a06914-fdcf-44e0-8c56-df9d06849a14\",\r\n  \"nicoVPCID\": \"7f8287c9-dc42-4a11-8920-1e61163f0fc1\",\r\n  \"nicoSubnetID\": \"28fa2c59-e2b6-4396-9397-e5865784be14\"\r\n}\r\n"]
[174.848919, "o", "$ [OSAC admin] python3 /tmp/nico-demo-binding.py\r\n"]
[179.787762, "o", "configmap/osac-nico-tenant-bindings patched\r\n"]
[227.179964, "o", "BMF mount verified: tenant-demo + 01a18561-d62a-732f-82c2-dcf65f861d92 -> AWX credentials [3, 6]\r\n"]
[227.365233, "o", "\r\n=== 6. Create one BMI through the public OSAC CLI ===\r\n"]
[232.172161, "o", "\r\n$ osac whoami\r\nLogged in as: tenant_demo_user\r\nTenant: tenant-demo\r\nRoles: offline_access, uma_authorization, default-roles-my realm\r\n\r\n$ osac get baremetalinstancecatalogitems nico-mat-pilot\r\n"]
[232.350929, "o", "TENANT  DELETING  ID                                    NAME            TITLE                      PUBLISHED\r\nshared  -         01a17e7f-5da5-74f1-addb-a750bf1092ec  nico-mat-pilot  NICo Machine-a-Tron pilot  true\r\n"]
[232.530639, "o", "\r\n$ osac get subnets nico-demo-subnet\r\n"]
[232.712506, "o", "TENANT       DELETING  PROJECT  ID                                    NAME              VIRTUAL-NETWORK  IPV4-CIDR        IPV6-CIDR  STATE\r\ntenant-demo  -         -        01a18561-d62a-732f-82c2-dcf65f861d92  nico-demo-subnet  nico-demo-vpc    10.217.100.0/28  -          READY\r\n\r\n$ osac get securitygroups nico-demo-sg\r\n"]
[232.893224, "o", "TENANT       DELETING  PROJECT  ID                                    NAME          VIRTUAL-NETWORK  INGRESS-RULES  EGRESS-RULES  STATE\r\ntenant-demo  -         -        01a18562-938c-7351-a188-e30e99b738a4  nico-demo-sg  nico-demo-vpc    0              0             READY\r\n"]
[233.073072, "o", "\r\n$ osac get baremetalinstances\r\n"]
[233.252903, "o", "There are no objects matching the given criteria.\r\n\r\n\r\n$ osac create baremetalinstance --name nico-demo-bmi-20261029020138 --catalog-item nico-mat-pilot \\\r\n    --instance-type nico-mat-control-plane --disk-image fedora \\\r\n    --network-attachment subnet=01a18561-d62a-732f-82c2-dcf65f861d92\\,interface=data-0\\,primary\\,security-groups=01a18562-938c-7351-a188-e30e99b738a4 --ssh-key \"$(cat /tmp/nico-osac-demo.pub)\"\r\n"]
[233.478656, "o", "Created bare metal instance '01a18564-3582-739d-852e-84af9cb3b9f6'.\r\n"]
[233.74565, "o", "\r\n$ osac get baremetalinstances nico-demo-bmi-20261029020138 -o json  # poll state\r\n"]
[234.011259, "o", "02:01:39 state=BARE_METAL_INSTANCE_STATE_PROVISIONING\r\n"]
[388.04122, "o", "02:04:14 state=BARE_METAL_INSTANCE_STATE_RUNNING\r\n\r\n$ osac get baremetalinstances nico-demo-bmi-20261029020138\r\n"]
[388.341881, "o", "TENANT       DELETING  ID                                    NAME                          CATALOG ITEM    DISK IMAGE  STATE    INTERNAL IP\r\ntenant-demo  -         01a18564-3582-739d-852e-84af9cb3b9f6  nico-demo-bmi-20261029020138  nico-mat-pilot  fedora      RUNNING  10.217.100.2\r\n"]
[388.523129, "o", "\r\n$ kubectl -n osac get baremetalinstance bmi-01a18564-3582-739d-852e-84af9cb3b9f6 -o json | jq selected status\r\n{\r\n  \"phase\": \"Ready\",\r\n  \"nicoInstanceID\": \"06d7bf99-2eef-4ce6-8e57-48888cc22ed7\",\r\n  \"nicoMachineID\": \"fm100hte4bdne640f6no73t0joo4s3irforbt7cirt2rmjuidhlnpj7kfag\",\r\n  \"provisioningJobs\": [\r\n    {\r\n      \"jobID\": \"28\",\r\n      \"message\": \"successful\",\r\n      \"state\": \"Succeeded\",\r\n      \"timestamp\": \"2026-10-29T02:01:39Z\",\r\n      \"type\": \"provision\"\r\n    }\r\n  ],\r\n  \"attachmentStatuses\": [\r\n    {\r\n      \"interface\": \"data-0\",\r\n      \"ipAddress\": \"10.217.100.2\",\r\n      \"primary\": true,\r\n      \"subnetRef\": \"01a18561-d62a-732f-82c2-dcf65f861d92\"\r\n    }\r\n  ]\r\n}\r\n"]
[388.708355, "o", "\r\n$ AWX create job 28 credential IDs\r\n[\r\n  3,\r\n  6\r\n]\r\n\r\nTenant isolation check: tenant2 cannot list tenant-demo BMI.\r\n"]
[388.956812, "o", "[]\r\n"]
[401.620253, "o", "$ [NICo tenant/provider] bash /tmp/nico-demo-inspect.sh created\r\n"]
[407.572104, "o", "\r\n$ curl GET /v2/org/test-org-demo/nico/instance/06d7bf99-2eef-4ce6-8e57-48888cc22ed7  # tenant identity\r\n"]
[407.77246, "o", "{\r\n  \"id\": \"06d7bf99-2eef-4ce6-8e57-48888cc22ed7\",\r\n  \"status\": \"Ready\",\r\n  \"tenantId\": \"62a06914-fdcf-44e0-8c56-df9d06849a14\",\r\n  \"vpcId\": \"7f8287c9-dc42-4a11-8920-1e61163f0fc1\",\r\n  \"machineId\": \"fm100hte4bdne640f6no73t0joo4s3irforbt7cirt2rmjuidhlnpj7kfag\",\r\n  \"interfaces\": [\r\n    {\r\n      \"id\": \"8a38a74b-2f54-4185-88a9-0c1e4e40dadf\",\r\n      \"instanceId\": \"06d7bf99-2eef-4ce6-8e57-48888cc22ed7\",\r\n      \"subnetId\": \"28fa2c59-e2b6-4396-9397-e5865784be14\",\r\n      \"subnet\": {\r\n        \"id\": \"28fa2c59-e2b6-4396-9397-e5865784be14\",\r\n        \"name\": \"osac-demo-subnet\",\r\n        \"controllerNetworkSegmentId\": \"28fa2c59-e2b6-4396-9397-e5865784be14\",\r\n        \"ipv4Prefix\": \"10.217.100.0\",\r\n        \"ipv6Prefix\": null,\r\n        \"prefixLength\": 28,\r\n        \"routingType\": \"DatacenterOnly\",\r\n        \"status\": \"Ready\"\r\n      },\r\n      \"vpcPrefixId\": null,\r\n      \"device\": null,\r\n      \"deviceInstance\": null,\r\n      \"virtualFunctionId\": null,\r\n      \"isPhysical\": true,\r\n      \"macAddress\": \"02:00:00:00:00:10\",\r\n      \"ipAddresses\": [\r\n        \"10.217.100.2\"\r\n      ],\r\n      \"ipPrefixes\": [\r\n        \"10.217.100.2/32\"\r\n      ],\r\n      \"requestedIpAddress\": null,\r\n      \"inlineRoutingProfile\": null,\r\n      \"status\": \"Ready\",\r\n      \"created\": \"2026-10-29T02:01:54.739231Z\",\r\n      \"updated\": \"2026-10-29T02:03:35.496714Z\"\r\n    }\r\n  ]\r\n}\r\n\r\n$ curl GET /v2/org/test-org/nico/machine/fm100hte4bdne640f6no73t0joo4s3irforbt7cirt2rmjuidhlnpj7kfag  # provider identity\r\n{\r\n  \"id\": \"fm100hte4bdne640f6no73t0joo4s3irforbt7cirt2rmjuidhlnpj7kfag\",\r\n  \"status\": \"InUse\",\r\n  \"instanceId\": \"06d7bf99-2eef-4ce6-8e57-48888cc22ed7\",\r\n  \"instanceTypeId\": \"f737c298-da6c-4517-9db0-7c7d6ed4c835\"\r\n}\r\n"]
[407.775226, "o", "\r\n=== 7. Delete through OSAC; wait for NICo Ready and verify ===\r\n"]
[412.887101, "o", "\r\n$ osac delete baremetalinstances nico-demo-bmi-20261029020138\r\n"]
[413.096905, "o", "Deleted baremetalinstances '01a18564-3582-739d-852e-84af9cb3b9f6'.\r\n\r\n$ kubectl -n osac get baremetalinstance bmi-01a18564-3582-739d-852e-84af9cb3b9f6 -o json | jq deletion and finalizers\r\n"]
[413.296266, "o", "{\r\n  \"deletionTimestamp\": \"2026-10-29T02:04:39Z\",\r\n  \"phase\": \"Deleting\",\r\n  \"nicoInstanceID\": \"06d7bf99-2eef-4ce6-8e57-48888cc22ed7\",\r\n  \"nicoMachineID\": \"fm100hte4bdne640f6no73t0joo4s3irforbt7cirt2rmjuidhlnpj7kfag\",\r\n  \"finalizers\": [\r\n    \"osac.openshift.io/baremetalinstance\",\r\n    \"osac.openshift.io/baremetalinstance-feedback\"\r\n  ]\r\n}\r\n\r\n$ osac get baremetalinstances  # wait for NICo cleanup before removal\r\n"]
[413.51769, "o", "\r\n=== 7. Continue waiting for NICo cleanup ===\r\n"]
[418.372199, "o", "\r\nDelete already submitted; continue waiting on its finalizer.\r\n\r\n$ osac get baremetalinstances  # wait for NICo cleanup before removal\r\n"]
